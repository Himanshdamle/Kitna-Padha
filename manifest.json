{
  "manifest_version": 3,
  "name": "Kitna Padha?",
  "version": "1.2.0",
  "description": "Adds a private study group layer to PW.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["tabs", "storage"],

  "host_permissions": [
    "https://kitnapadhabackend-production.up.railway.app/*",
    "https://api.penpencil.co/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://*.pw.live/*"],
      "js": ["events.js", "dom.js", "pwApi.js", "content.js"]
    }
  ]
}
